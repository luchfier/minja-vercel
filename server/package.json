{
  "name": "minjaphotobooth-server",
  "version": "1.0.0",
  "description": "MinjaPhotobooth Backend API Server",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "reset-admin": "tsx scripts/reset-admin-pin.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "^10.1.7",
    "@prisma/client": "^5.22.0",
    "@types/nodemailer": "^8.0.2",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.2.1",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "prisma": "^5.22.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
